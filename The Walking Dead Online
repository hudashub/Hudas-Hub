        local nextVal = items[idx]
        valLabel.Text = tostring(nextVal)
        setState(nextVal)
    end)
end

local function slider(lbl, minV, maxV, defV, fn)
    local row = Instance.new("Frame", currentCol)
    row.Size = UDim2.new(1, 0, 0, 50)
    row.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    row.LayoutOrder = nextOrder; nextOrder = nextOrder + 1
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rst = Instance.new("UIStroke", row); rst.Color = Color3.fromRGB(235, 70, 50); rst.Transparency = 0.85
    
    mkLabel(row, lbl, UDim2.new(0.58, 0, 0, 20), UDim2.new(0, 12, 0, 4), 12, nil, Color3.fromRGB(180, 180, 180), 1)
    local vl = mkLabel(row, tostring(defV), UDim2.new(0.38, 0, 0, 20), UDim2.new(0.6, 0, 0, 4), 12, Enum.Font.GothamBold, Color3.fromRGB(235, 70, 50), 1, Enum.TextXAlignment.Right)
    
    local trk = Instance.new("Frame", row)
    trk.Size = UDim2.new(1, -24, 0, 6)
    trk.Position = UDim2.new(0, 12, 0, 32)
    trk.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    Instance.new("UICorner", trk).CornerRadius = UDim.new(1, 0)
    
    local pct = (defV - minV) / (maxV - minV)
    local fl = Instance.new("Frame", trk)
    fl.Size = UDim2.new(pct, 0, 1, 0)
    fl.BackgroundColor3 = Color3.fromRGB(235, 70, 50)
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
    
    local th = Instance.new("TextButton", trk)
    th.Size = UDim2.fromOffset(14, 14)
    th.Position = UDim2.new(pct, -7, 0.5, -7)
    th.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    th.Text = ""; th.ZIndex = 2
    Instance.new("UICorner", th).CornerRadius = UDim.new(1, 0)
    
    local function setSlider(v)
        v = math.clamp(math.floor(tonumber(v) or defV), minV, maxV)
        local r = (v - minV) / (maxV - minV)
        fl.Size = UDim2.new(r, 0, 1, 0)
        th.Position = UDim2.new(r, -7, 0.5, -7)
        vl.Text = tostring(v)
        fn(v)
    end
    
    local drag = false
    th.InputBegan:Connect(function(ip)
        if ip.UserInputType == Enum.UserInputType.MouseButton1 or ip.UserInputType == Enum.UserInputType.Touch then drag = true end
    end)
    track(UserInputService.InputChanged:Connect(function(ip)
        if drag and (ip.UserInputType == Enum.UserInputType.MouseMovement or ip.UserInputType == Enum.UserInputType.Touch) then
            local rx = (ip.Position.X - trk.AbsolutePosition.X) / trk.AbsoluteSize.X
            setSlider(minV + math.clamp(rx, 0, 1) * (maxV - minV))
        end
    end))
    track(UserInputService.InputEnded:Connect(function(ip)
        if ip.UserInputType == Enum.UserInputType.MouseButton1 or ip.UserInputType == Enum.UserInputType.Touch then drag = false end
    end))
end

