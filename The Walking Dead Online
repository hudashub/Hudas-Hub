-- ─── INSTANT ANIMATION SUPPRESSOR FOR AUTO HEAL / EAT / DRINK ───────
local function setupAnimationSuppressor(char)
    if animConn then untrack(animConn); animConn = nil end
    if not char then return end
    
    local humanoid = char:WaitForChild("Humanoid", 3)
    if humanoid then
        animConn = humanoid.AnimationPlayed:Connect(function(trackAnim)
            if State.AutoHealEatDrink then
                local animName = trackAnim.Name:lower()
                if animName:match("eat") or animName:match("drink") or animName:match("heal") or animName:match("bandage") or animName:match("med") or animName:match("consume") or animName:match("use") then
                    pcall(function() trackAnim:Stop(0) end)
                end
            end
        end)
        track(animConn)
    end
end

if player.Character then setupAnimationSuppressor(player.Character) end
track(player.CharacterAdded:Connect(setupAnimationSuppressor))

-- ─── HEADSHOT HITBOX EXPANDED SYSTEM ────────────────────────────────
local function startHitboxExpanderLoop()
    if hitboxThread then
        pcall(function() task.cancel(hitboxThread) end)
        hitboxThread = nil
    end
    
    if not State.HitboxExpander then
        restoreHeadSizes()
        return
    end
    
    hitboxThread = task.spawn(function()
        while State.HitboxExpander and myLoopID == _G.TWDOLoopID do
            pcall(function()
                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then table.insert(targets, p.Character) end
                end
                
                local walkerFolders = {
                    workspace:FindFirstChild("AI") and workspace.AI:FindFirstChild("Walkers"),
                    workspace:FindFirstChild("PresetWalkers")
                }
                for _, folder in ipairs(walkerFolders) do
                    if folder then
                        for _, w in ipairs(folder:GetChildren()) do
                            if w:IsA("Model") then table.insert(targets, w) end
                        end
                    end
                end
                
                local targetSize = Vector3.new(State.HitboxSize or 5, State.HitboxSize or 5, State.HitboxSize or 5)
                
                for _, model in ipairs(targets) do
                    local hum = model:FindFirstChild("Humanoid")
                    local head = model:FindFirstChild("Head")
                    if hum and hum.Health > 0 and head and head:IsA("BasePart") then
                        if not originalHeadSizes[head] then
                            originalHeadSizes[head] = head.Size
                        end
                        head.Size = targetSize
                        head.CanCollide = false
                        head.Transparency = 0.6
                    end
                end
            end)
            task.wait(0.5)
        end
    end)
    trackThread(hitboxThread)
end

-- ─── AUTO SURVIVAL LOOP (EAT, DRINK, HEAL - ZERO ANIMATION) ─────────
local function startAutoSurvivalLoop()
    if autoSurvivalThread then
        pcall(function() task.cancel(autoSurvivalThread) end)
        autoSurvivalThread = nil
    end
    
    if not State.AutoHealEatDrink then return end
    
    autoSurvivalThread = task.spawn(function()
        while State.AutoHealEatDrink and myLoopID == _G.TWDOLoopID do
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local clientRemotes = RS:FindFirstChild("CLIENT_REMOTES")
                    local healRemote = clientRemotes and clientRemotes:FindFirstChild("Heal")
                    
                    -- Check Health Threshold
                    if hum.Health < (State.HealthThreshold or 60) then
                        for _, item in ipairs(player.Backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                local lowerName = item.Name:lower()
                                if lowerName:match("bandage") or lowerName:match("med") or lowerName:match("firstaid") or lowerName:match("heal") or lowerName:match("blood") then
                                    if healRemote then
                                        healRemote:FireServer(item)
                                    else
                                        hum.Health = math.min(hum.MaxHealth, hum.Health + 35)
                                        item:Destroy()
                                    end
                                    break
                                end
                            end
                        end
                    end
                    
                    -- Check Hunger & Thirst Attributes
                    local hunger = char:GetAttribute("Hunger") or player:GetAttribute("Hunger") or 100
                    local thirst = char:GetAttribute("Thirst") or player:GetAttribute("Thirst") or 100
                    
                    if hunger < (State.HungerThirstThreshold or 50) or thirst < (State.HungerThirstThreshold or 50) then
                        for _, item in ipairs(player.Backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                local lowerName = item.Name:lower()
                                local isFood = lowerName:match("can") or lowerName:match("food") or lowerName:match("meat") or lowerName:match("apple") or lowerName:match("ration")
                                local isDrink = lowerName:match("water") or lowerName:match("drink") or lowerName:match("soda") or lowerName:match("bottle") or lowerName:match("canteen")
                                
                                if isFood or isDrink then
                                    if char:GetAttribute("Hunger") then char:SetAttribute("Hunger", 100) end
                                    if player:GetAttribute("Hunger") then player:SetAttribute("Hunger", 100) end
                                    if char:GetAttribute("Thirst") then char:SetAttribute("Thirst", 100) end
                                    if player:GetAttribute("Thirst") then player:SetAttribute("Thirst", 100) end
                                    item:Destroy()
                                    break
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(1.5)
        end
    end)
    trackThread(autoSurvivalThread)
end

-- ─── AUTO VEHICLE REFILL LOOP (SPEED UNTOUCHED) ────────────────────
local function startVehicleRefillLoop()
    if vehicleThread then
        pcall(function() task.cancel(vehicleThread) end)
        vehicleThread = nil
    end
    
    if not State.AutoFillVehicle then return end
    
    vehicleThread = task.spawn(function()
        while State.AutoFillVehicle and myLoopID == _G.TWDOLoopID do
            pcall(function()
                local clientRemotes = RS:FindFirstChild("CLIENT_REMOTES")
                local pumpGas = clientRemotes and clientRemotes:FindFirstChild("PumpGas")
                local fillCar = clientRemotes and clientRemotes:FindFirstChild("FillCar")
                
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local seat = hum and hum.SeatPart
                local vehicle = seat and seat:FindFirstAncestorWhichIsA("Model")
                
                if vehicle then
                    if fillCar then fillCar:FireServer(vehicle) end
                    if pumpGas then pumpGas:FireServer(vehicle) end
                    
                    if vehicle:GetAttribute("Fuel") then vehicle:SetAttribute("Fuel", 100) end
                    if vehicle:GetAttribute("Gas") then vehicle:SetAttribute("Gas", 100) end
                end
            end)
            task.wait(2.0)
        end
    end)
    trackThread(vehicleThread)
end

-- ─── WEAPON MODIFIERS (RECOIL, INSTANT RELOAD, INF AMMO & DURA) ───
-- processedGunModules lives outside the loop so it persists between ticks
-- and we never re-require a module we already patched
local processedGunModules = setmetatable({}, {__mode = "k"})

-- Cache of backpack items already scanned — invalidated on backpack change
local backpackDirty = true
track(player.Backpack.ChildAdded:Connect(function() backpackDirty = true end))
track(player.Backpack.ChildRemoved:Connect(function() backpackDirty = true end))

trackThread(task.spawn(function()
    while true do
        if myLoopID ~= _G.TWDOLoopID then break end

        -- Stamina & blur enforcement
        pcall(function()
            if State.InfStamina then
                local char = player.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    if hum and hum.WalkSpeed < 23 then hum.WalkSpeed = 23 end
                    local stam = char:FindFirstChild("Stamina") or char:FindFirstChild("Sprint")
                    if stam and stam:IsA("ValueObject") then stam.Value = stam.MaxValue or 100 end
                    if char:GetAttribute("Stamina") then char:SetAttribute("Stamina", 100) end
                end
                if player:GetAttribute("Stamina") then player:SetAttribute("Stamina", 100) end

                local lighting = game:GetService("Lighting")
                local sBlur = lighting:FindFirstChild("StaminaBlur")
                if sBlur then sBlur.Enabled = false; sBlur.Size = 0 end
                local cBlur = lighting:FindFirstChild("CharBlur")
                if cBlur then cBlur.Enabled = false; cBlur.Size = 0 end

                local userGui = player.PlayerGui:FindFirstChild("UserGUI")
                if userGui then
                    for _, vName in ipairs({"ShootVignette", "HurtVignette", "StaminaVignette"}) do
                        local v = userGui:FindFirstChild(vName)
                        if v then v.ImageTransparency = 1; v.Visible = false end
                    end
                end
            end
        end)

        -- Gun config patching — only when features are on AND backpack changed
        if (State.NoRecoilSpread or State.InstantReload) and backpackDirty then
            backpackDirty = false
            pcall(function()
                -- Patch the shared ItemData module once
                if State.NoRecoilSpread and ItemDataModule and type(ItemDataModule) == "table" then
                    for _, gun in pairs(ItemDataModule) do
                        if type(gun) == "table" and (gun.Type == "Gun" or gun.Recoil ~= nil) then
                            if not processedGunModules[gun] then
                                gun.Recoil = 0; gun.SpreadAngle = 0; gun.ADSSpreadAngle = 0
                                gun.BloomAdd = 0; gun.ADSBloomAdd = 0; gun.MaxBloom = 0
                                gun.ADSMaxBloom = 0
                                if gun.Kick then gun.Kick = 0 end
                                if gun.KickUp then gun.KickUp = 0 end
                                if gun.Spray then gun.Spray = 0 end
                                if gun.Accuracy then gun.Accuracy = 1 end
                                processedGunModules[gun] = true
                            end
                        end
                    end
                end

                local function modifyConfig(inst)
                    if processedGunModules[inst] then return end
                    if inst:IsA("ModuleScript") and (
                        inst.Name:lower():match("config") or
                        inst.Name:lower():match("setting") or
                        inst.Name:lower():match("gun")
                    ) then
                        local ok, config = pcall(require, inst)
                        if ok and type(config) == "table" then
                            if State.NoRecoilSpread then
                                config.Recoil = 0; config.Spread = 0
                                config.MinSpread = 0; config.MaxSpread = 0
                                config.SpreadAngle = 0; config.ADSSpreadAngle = 0
                                config.BloomAdd = 0; config.ADSBloomAdd = 0
                                config.MaxBloom = 0; config.ADSMaxBloom = 0
                                config.Spray = 0; config.Kick = 0; config.KickUp = 0
                            end
                            if State.InstantReload then
                                if config.ReloadTime then config.ReloadTime = 0.01 end
                                if config.TacticalReloadTime then config.TacticalReloadTime = 0.01 end
                                if config.EmptyReloadTime then config.EmptyReloadTime = 0.01 end
                                if config.ReloadSpeed then config.ReloadSpeed = 100 end
                            end
                            processedGunModules[inst] = true
                        end
                    end
                end

                for _, item in ipairs(player.Backpack:GetDescendants()) do
                    pcall(modifyConfig, item)
                end
                local char = player.Character
                if char then
                    for _, item in ipairs(char:GetDescendants()) do
                        pcall(modifyConfig, item)
                    end
                end
            end)
        end

        task.wait(0.5)
    end
end))

-- ─── NOCLIP LOGIC ─────────────────────────────────────────────
local noclipConnection  = nil
local noclipPreSimConn  = nil

local function updateNoclip()
    if noclipPreSimConn then untrack(noclipPreSimConn); noclipPreSimConn = nil end
    if noclipConnection  then untrack(noclipConnection);  noclipConnection  = nil end

    if not State.Noclip then return end

    -- PreSimulation fires BEFORE the physics engine resolves collisions each step.
    -- Setting CanCollide=false here means the engine never builds a constraint
    -- or correction force, so there is no rubber-band / rollback at all.
    noclipPreSimConn = RunService.PreSimulation:Connect(function()
        local char = player.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
    track(noclipPreSimConn)

    -- PostSimulation: assert client network ownership on HRP so the server
    -- does not teleport us back via its own position authority.
    noclipConnection = RunService.PostSimulation:Connect(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                if hrp:GetNetworkOwner() ~= player then
                    hrp:SetNetworkOwner(player)
                end
            end)
        end
    end)
    track(noclipConnection)
end

-- ─── GOD MODE (DESYNC) LOGIC ───────────────────────────────────────
local godModeConnection = nil
local originalRootC0 = nil
local originalRootJointC0 = nil

local function applyDesync(c)
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    
    local lowerTorso = c:FindFirstChild("LowerTorso")
    local root = lowerTorso and lowerTorso:FindFirstChild("Root")
    local rootJoint = hrp:FindFirstChild("RootJoint")
    local cam = workspace.CurrentCamera
    
    if State.GodMode then
        if cam then cam.CameraSubject = hrp end
        if root then
            if not originalRootC0 then originalRootC0 = root.C0 end
            root.C0 = CFrame.new(0, -500, 0)
        elseif rootJoint then
            if not originalRootJointC0 then originalRootJointC0 = rootJoint.C0 end
            rootJoint.C0 = CFrame.new(0, -500, 0)
        end
    else
        if root and originalRootC0 then root.C0 = originalRootC0 end
        if rootJoint and originalRootJointC0 then rootJoint.C0 = originalRootJointC0 end
        if cam and hum then cam.CameraSubject = hum end
    end
end

local function updateGodMode()
    local char = player.Character
    if State.GodMode then
        if char then applyDesync(char) end
        if not godModeConnection then
            godModeConnection = player.CharacterAdded:Connect(function(newChar)
                task.wait(0.5)
                if State.GodMode then applyDesync(newChar) end
            end)
            track(godModeConnection)
        end
    else
        if godModeConnection then
            untrack(godModeConnection)
            godModeConnection = nil
        end
        if char then applyDesync(char) end
    end
end

_G.restoreGodMode = function()
    if godModeConnection then untrack(godModeConnection) end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local lowerTorso = char:FindFirstChild("LowerTorso")
        local root = lowerTorso and lowerTorso:FindFirstChild("Root")
        local rootJoint = hrp and hrp:FindFirstChild("RootJoint")
        if root and originalRootC0 then root.C0 = originalRootC0 end
        if rootJoint and originalRootJointC0 then rootJoint.C0 = originalRootJointC0 end
        local cam = workspace.CurrentCamera
        if cam and char:FindFirstChild("Humanoid") then
            cam.CameraSubject = char.Humanoid
        end
    end
end

-- ─── ARMOR & ITEM HELPER ───────────────────────────────────────────
local function getArmorStats(char)
    local helmetName, helmetDura = nil, nil
    local armorName, armorDura = nil, nil
    
    if not ItemDataModule then
        pcall(function()
            local modules = RS:FindFirstChild("CLIENT_MODULES")
            local itemDataMod = modules and modules:FindFirstChild("ItemData")
            if itemDataMod then ItemDataModule = require(itemDataMod) end
        end)
    end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") then
            local data = ItemDataModule and ItemDataModule[child.Name]
            local dura = child:GetAttribute("DuraTex") or "N/A"
            local nameLower = child.Name:lower()
            
            local isHelmet = nameLower:match("helmet") or nameLower:match("helm") or nameLower:match("mask") or nameLower:match("cap") or nameLower:match("hat")
            local isArmor = nameLower:match("vest") or nameLower:match("armor") or nameLower:match("chestplate") or nameLower:match("carrier")
            
            if data and data.Type == "Armor" then
                if data.ArmorType == "Helmet" then isHelmet = true; isArmor = false
                elseif data.ArmorType == "BodyArmor" then isArmor = true; isHelmet = false end
            end
            
            if nameLower:match("nvg") or nameLower:match("backpack") then isHelmet = false; isArmor = false end
            
            if isHelmet then helmetName = child.Name; helmetDura = dura
            elseif isArmor then armorName = child.Name; armorDura = dura end
        end
    end
    return helmetName, helmetDura, armorName, armorDura
end

