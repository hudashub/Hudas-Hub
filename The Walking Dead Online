local function startLootEspLoop()
    for _, c in ipairs(lootEspConnections) do pcall(function() c:Disconnect() end) end
    lootEspConnections = {}
    
    if lootThread then
        pcall(function() task.cancel(lootThread) end)
        lootThread = nil
    end
    
    if not State.LootESP then
        cleanAllLootEsp()
        return
    end
    
    local function checkLootable(obj)
        if not obj:IsDescendantOf(workspace) or LootEspInstances[obj] then return end
        
        if obj.Parent and obj.Parent.Name == "Corpses" then
            applyLootEsp(obj, "💀 Corpse: " .. obj.Name, Color3.fromRGB(220, 60, 60))
            return
        end
        
        if obj:IsA("Tool") then
            applyLootEsp(obj, "🔫 " .. obj.Name, Color3.fromRGB(235, 80, 180))
            return
        end
        
        if obj:IsA("Model") then
            local lowerName = obj.Name:lower()
            if lowerName:match("^loot_") or lowerName:match("crate") or lowerName:match("container") or lowerName:match("chest") or lowerName:match("bag") or lowerName:match("suitcase") then
                local cleanName = obj.Name:gsub("^Loot_", ""):gsub("_", " ")
                applyLootEsp(obj, "📦 " .. cleanName, Color3.fromRGB(235, 180, 50))
            end
        end
    end
    
    local scanFolders = {
        workspace:FindFirstChild("ItemDrops"),
        workspace:FindFirstChild("PhysicalLoot"),
        workspace:FindFirstChild("Lootables"),
        workspace:FindFirstChild("Corpses")
    }
    
    for _, folder in ipairs(scanFolders) do
        if folder then
            for _, descendant in ipairs(folder:GetChildren()) do
                pcall(checkLootable, descendant)
            end
            local conn = folder.ChildAdded:Connect(function(child)
                pcall(checkLootable, child)
            end)
            table.insert(lootEspConnections, conn)
            track(conn)
        end
    end
    
    lootThread = task.spawn(function()
        while State.LootESP and myLoopID == _G.TWDOLoopID do
            local localChar = player.Character
            local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
            
            if localHrp then
                local myPos = localHrp.Position
                local maxDist = State.LootDistance or 300
                
                local toProcess = {}
                for obj, instances in pairs(LootEspInstances) do
                    table.insert(toProcess, {obj = obj, instances = instances})
                end
                
                for index, item in ipairs(toProcess) do
                    if index % 25 == 0 then task.wait() end
                    if not State.LootESP then break end
                    
                    local obj = item.obj
                    local instances = item.instances
                    
                    pcall(function()
                        if not obj or not obj.Parent then
                            cleanLootEsp(obj)
                            return
                        end
                        
                        local bb = instances and instances[1]
                        if bb and bb.Adornee and bb.Adornee.Parent then
                            local pos = bb.Adornee:IsA("BasePart") and bb.Adornee.Position or bb.Adornee:GetPivot().Position
                            local dist = (myPos - pos).Magnitude
                            local inRange = dist <= maxDist
                            
                            bb.Enabled = inRange
                            if inRange then
                                local label = bb:FindFirstChildWhichIsA("TextLabel")
                                if label then
                                    local prefix = obj.Parent and obj.Parent.Name == "Corpses" and "💀 " or (obj:IsA("Tool") and "🔫 " or "📦 ")
                                    local cleanName = obj.Name:gsub("^Loot_", ""):gsub("_", " ")
                                    label.Text = string.format("%s%s  •  %dm", prefix, cleanName, math.floor(dist))
                                end
                            end
                        else
                            cleanLootEsp(obj)
                        end
                    end)
                end
            end
            task.wait(1.0)
        end
    end)
    trackThread(lootThread)
end

