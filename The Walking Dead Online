-- ─── ZERO-LEAK SIGNAL & THREAD TRACKING ────────────────────────────
local _CONNS = setmetatable({}, {__mode = "k"})
local _THREADS = {}

local function track(conn)
    if conn then _CONNS[conn] = true end
    return conn
end

local function untrack(conn)
    if conn then
        pcall(function() conn:Disconnect() end)
        _CONNS[conn] = nil
    end
end

local function trackThread(t)
    table.insert(_THREADS, t)
    return t
end

-- Weak-key metatables prevent memory leaks when Instances despawn or unstream
local WalkerEspInstances = setmetatable({}, {__mode = "k"})
local LootEspInstances   = setmetatable({}, {__mode = "k"})
local originalHeadSizes  = setmetatable({}, {__mode = "k"})

local lootEspConnections = {}
local fovCircleGui

local function cleanEspForWalker(obj)
    if WalkerEspInstances[obj] then
        for _, inst in ipairs(WalkerEspInstances[obj]) do
            pcall(function() inst:Destroy() end)
        end
        WalkerEspInstances[obj] = nil
    end
end

local function cleanAllWalkerEsp()
    for obj, _ in pairs(WalkerEspInstances) do
        cleanEspForWalker(obj)
    end
end

local function cleanLootEsp(obj)
    if LootEspInstances[obj] then
        for _, inst in ipairs(LootEspInstances[obj]) do
            pcall(function() inst:Destroy() end)
        end
        LootEspInstances[obj] = nil
    end
end

local function cleanAllLootEsp()
    for obj, _ in pairs(LootEspInstances) do
        cleanAllLootEsp(obj)
    end
end

-- Centralized Player ESP Data
local PlayerEspGuis = setmetatable({}, {__mode = "k"})

local function cleanEspForPlayer(p)
    local guiData = PlayerEspGuis[p]
    if guiData then
        pcall(function() if guiData.Highlight then guiData.Highlight:Destroy() end end)
        pcall(function() if guiData.Billboard then guiData.Billboard:Destroy() end end)
        PlayerEspGuis[p] = nil
    end
end

local function cleanAllEsp()
    for p, _ in pairs(PlayerEspGuis) do
        cleanEspForPlayer(p)
    end
    PlayerEspGuis = {}
end

local playerEspRenderConn = nil
local walkerThread = nil
local lootThread = nil
