-- ─── NOCLIP LOGIC (MULTI-PHASE HYBRID STEPPED + POSITIONAL SHIFT) ──
local noclipConnection = nil
local function updateNoclip()
    if noclipConnection then
        untrack(noclipConnection)
        noclipConnection = nil
    end
    
    if State.Noclip then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = player.Character
            if not char then return end
            
            -- Disable CanCollide on all character parts & hitboxes
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if part.CanCollide then part.CanCollide = false end
                end
            end
            
            -- Active Phase Offset when moving towards walls to prevent rollback teleports
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    sharedRaycastParams.FilterDescendantsInstances = {char}
                    local rayResult = workspace:Raycast(hrp.Position, moveDir * 2.5, sharedRaycastParams)
                    if rayResult then
                        hrp.CFrame = hrp.CFrame + (moveDir * 1.5)
                    end
                end
            end
        end)
        track(noclipConnection)
    end
end

-- ─── GOD MODE (DESYNC) LOGIC ───────────────────────────────────────
local godModeConnection = nil
local originalRootC0 = nil
local originalRootJointC0 = nil

local function applyDesync(c)
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    
    local lowerTorso = c:FindFirstChild("LowerTorso")
    local root = lowerTorso and lowerTorso:FindFirstChild("Root")
    local rootJoint = hrp:FindFirstChild("RootJoint")
    local cam = workspace.CurrentCamera
    
    if State.GodMode then
        if cam then cam.CameraSubject = hrp end
        if root then
            if not originalRootC0 then originalRootC0 = root.C0 end
            root.C0 = CFrame.new(0, -500, 0)
        elseif rootJoint then
            if not originalRootJointC0 then originalRootJointC0 = rootJoint.C0 end
            rootJoint.C0 = CFrame.new(0, -500, 0)
        end
    else
        if root and originalRootC0 then root.C0 = originalRootC0 end
        if rootJoint and originalRootJointC0 then rootJoint.C0 = originalRootJointC0 end
        if cam and hum then cam.CameraSubject = hum end
    end
end

local function updateGodMode()
    local char = player.Character
    if State.GodMode then
        if char then applyDesync(char) end
        if not godModeConnection then
            godModeConnection = player.CharacterAdded:Connect(function(newChar)
                task.wait(0.5)
                if State.GodMode then applyDesync(newChar) end
            end)
            track(godModeConnection)
        end
    else
        if godModeConnection then
            untrack(godModeConnection)
            godModeConnection = nil
        end
        if char then applyDesync(char) end
    end
end

_G.restoreGodMode = function()
    if godModeConnection then untrack(godModeConnection) end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local lowerTorso = char:FindFirstChild("LowerTorso")
        local root = lowerTorso and lowerTorso:FindFirstChild("Root")
        local rootJoint = hrp and hrp:FindFirstChild("RootJoint")
        if root and originalRootC0 then root.C0 = originalRootC0 end
        if rootJoint and originalRootJointC0 then rootJoint.C0 = originalRootJointC0 end
        local cam = workspace.CurrentCamera
        if cam and char:FindFirstChild("Humanoid") then
            cam.CameraSubject = char.Humanoid
        end
    end
end

-- ─── ARMOR & ITEM HELPER ───────────────────────────────────────────
local function getArmorStats(char)
    local helmetName, helmetDura = nil, nil
    local armorName, armorDura = nil, nil
    
    if not ItemDataModule then
        pcall(function()
            local modules = RS:FindFirstChild("CLIENT_MODULES")
            local itemDataMod = modules and modules:FindFirstChild("ItemData")
            if itemDataMod then ItemDataModule = require(itemDataMod) end
        end)
    end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") then
            local data = ItemDataModule and ItemDataModule[child.Name]
            local dura = child:GetAttribute("DuraTex") or "N/A"
            local nameLower = child.Name:lower()
            
            local isHelmet = nameLower:match("helmet") or nameLower:match("helm") or nameLower:match("mask") or nameLower:match("cap") or nameLower:match("hat")
            local isArmor = nameLower:match("vest") or nameLower:match("armor") or nameLower:match("chestplate") or nameLower:match("carrier")
            
            if data and data.Type == "Armor" then
                if data.ArmorType == "Helmet" then isHelmet = true; isArmor = false
                elseif data.ArmorType == "BodyArmor" then isArmor = true; isHelmet = false end
            end
            
            if nameLower:match("nvg") or nameLower:match("backpack") then isHelmet = false; isArmor = false end
            
            if isHelmet then helmetName = child.Name; helmetDura = dura
            elseif isArmor then armorName = child.Name; armorDura = dura end
        end
    end
    return helmetName, helmetDura, armorName, armorDura
end

