end

-- Track per-player health change connections for instant ESP health updates
-- Weak-value so GC cleans up if the player leaves before we manually do
local playerHealthConns = {}

local function hookPlayerEsp(p)
    if p == player then return end
    track(p.CharacterAdded:Connect(function(char)
        if not State.PlayerESP then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            createPlayerEspGui(p, char, hrp)
        end
        -- Wire up instant health-change label refresh
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            if playerHealthConns[p] then
                pcall(function() playerHealthConns[p]:Disconnect() end)
            end
            playerHealthConns[p] = hum:GetPropertyChangedSignal("Health"):Connect(function()
                local guiData = PlayerEspGuis[p]
                if guiData and guiData.Label and State.ESPShowHealth then
                    local currentText = guiData.Label.Text
                    -- Replace HP portion inline to avoid full rebuild
                    local hp = math.floor(hum.Health)
                    guiData.Label.Text = currentText:gsub("%d+ HP", hp .. " HP")
                end
            end)
        end
    end))
    -- Hook current character if already loaded
    local char = p.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if char and hrp and State.PlayerESP then
        createPlayerEspGui(p, char, hrp)
        -- Also hook health immediately for existing chars
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            if playerHealthConns[p] then
                pcall(function() playerHealthConns[p]:Disconnect() end)
            end
            playerHealthConns[p] = hum:GetPropertyChangedSignal("Health"):Connect(function()
                local guiData = PlayerEspGuis[p]
                if guiData and guiData.Label and State.ESPShowHealth then
                    local hp = math.floor(hum.Health)
                    guiData.Label.Text = guiData.Label.Text:gsub("%d+ HP", hp .. " HP")
                end
            end)
        end
    end
end

local playerEspUpdateThread = nil
local playerAddedConn = nil

local function startEspLoop()
    -- Tear down old state
    if playerEspRenderConn then untrack(playerEspRenderConn); playerEspRenderConn = nil end
    if playerEspUpdateThread then pcall(function() task.cancel(playerEspUpdateThread) end); playerEspUpdateThread = nil end
    if playerAddedConn then untrack(playerAddedConn); playerAddedConn = nil end
    cleanAllEsp()

    if not State.PlayerESP then return end

    -- Immediately wire all current players
    for _, p in ipairs(Players:GetPlayers()) do
        hookPlayerEsp(p)
    end

    -- Instantly pick up new joiners
    playerAddedConn = Players.PlayerAdded:Connect(function(p)
        if State.PlayerESP then hookPlayerEsp(p) end
    end)
    track(playerAddedConn)

    -- Slow update loop (~4fps) — only updates labels/visibility, no instance creation
    playerEspUpdateThread = task.spawn(function()
        while State.PlayerESP and myLoopID == _G.TWDOLoopID do
            pcall(function()
                if not State.PlayerESP then return end

                local localChar = player.Character
                local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
                local myPos = localHrp and localHrp.Position
                local cam = workspace.CurrentCamera
                local maxDist = State.ESPDistance or 1000

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player then
                        local char = p.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")

                        if char and hrp and hum and hum.Health > 0 and char.Parent then
                            local guiData = PlayerEspGuis[p]
                            -- Re-create if char changed (respawn) or ESP was destroyed
                            if not guiData or guiData.Char ~= char
                                or not guiData.Highlight.Parent then
                                createPlayerEspGui(p, char, hrp)
                                guiData = PlayerEspGuis[p]
                            end

                            if guiData then
                                local dist = myPos and (myPos - hrp.Position).Magnitude or 0
                                local inRange = dist <= maxDist
                                local isVisible = true

                                if inRange and State.ESPOnlyVisible and cam and localChar then
                                    sharedRaycastParams.FilterDescendantsInstances = {localChar, char}
                                    local ray = workspace:Raycast(
                                        cam.CFrame.Position,
                                        hrp.Position - cam.CFrame.Position,
                                        sharedRaycastParams
                                    )
                                    if ray then isVisible = false end
                                end

                                -- Highlight off behind wall; billboard always visible
                                guiData.Highlight.Enabled = inRange and (not State.ESPOnlyVisible or isVisible)
                                guiData.Billboard.Enabled = inRange  -- always show stats

                                if inRange then
                                    local lines = {}
                                    if State.ESPShowName then
                                        table.insert(lines, p.Name)
                                    end

                                    local infoParts = {}
                                    if State.ESPShowHealth then
                                        table.insert(infoParts, string.format("%d HP", math.floor(hum.Health)))
                                    end
                                    if State.ESPShowDistance then
                                        table.insert(infoParts, string.format("%dm", math.floor(dist)))
                                    end
                                    if #infoParts > 0 then
                                        table.insert(lines, table.concat(infoParts, " • "))
                                    end

                                    if State.ESPShowArmor then
                                        local helmetName, _, armorName, _ = getArmorStats(char)
                                        local armorLine = {}
                                        if helmetName then table.insert(armorLine, "🪖 " .. helmetName:gsub(" Helmet", ""):gsub(" Helm", "")) end
                                        if armorName  then table.insert(armorLine, "👕 " .. armorName:gsub(" Armor", ""):gsub(" Vest", "")) end
                                        if #armorLine > 0 then table.insert(lines, table.concat(armorLine, " ")) end
                                    end

                                    guiData.Label.Text = table.concat(lines, "\n")
                                    -- White = visible, grey = behind wall (stats still readable)
                                    guiData.Label.TextColor3 = isVisible
                                        and Color3.new(1, 1, 1)
                                        or  Color3.fromRGB(170, 170, 170)
                                end
                            end
                        else
                            cleanEspForPlayer(p)
                        end
                    end
                end
            end)
            task.wait(0.25) -- ~4fps update rate, zero render thread impact
        end
        -- Auto-off cleanup
        if not State.PlayerESP then
            if playerAddedConn then untrack(playerAddedConn); playerAddedConn = nil end
            for _, conn in pairs(playerHealthConns) do
                pcall(function() conn:Disconnect() end)
            end
            for k in pairs(playerHealthConns) do playerHealthConns[k] = nil end
            cleanAllEsp()
        end
    end)
    trackThread(playerEspUpdateThread)
end

