        untrack(playerEspRenderConn)
        playerEspRenderConn = nil
    end
    
    cleanAllEsp()
    
    if not State.PlayerESP then return end
    
    playerEspRenderConn = RunService.RenderStepped:Connect(function()
        if not State.PlayerESP then
            cleanAllEsp()
            if playerEspRenderConn then untrack(playerEspRenderConn); playerEspRenderConn = nil end
            return
        end
        
        local localChar = player.Character
        local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local myPos = localHrp and localHrp.Position
        local cam = workspace.CurrentCamera
        local maxDist = State.ESPDistance or 1000
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                
                if char and hrp and hum and hum.Health > 0 and char.Parent then
                    local guiData = PlayerEspGuis[p]
                    if not guiData or guiData.Char ~= char or not guiData.Highlight.Parent then
                        createPlayerEspGui(p, char, hrp)
                        guiData = PlayerEspGuis[p]
                    end
                    
                    if guiData then
                        local dist = myPos and (myPos - hrp.Position).Magnitude or 0
                        local inRange = dist <= maxDist
                        local isVisible = true
                        
                        if inRange and State.ESPOnlyVisible and cam and localChar then
                            sharedRaycastParams.FilterDescendantsInstances = {localChar, char}
                            local rayResult = workspace:Raycast(cam.CFrame.Position, hrp.Position - cam.CFrame.Position, sharedRaycastParams)
                            if rayResult then isVisible = false end
                        end
                        
                        guiData.Highlight.Enabled = inRange and isVisible
                        guiData.Billboard.Enabled = inRange
                        
                        if inRange then
                            local lines = {}
                            if State.ESPShowName then
                                table.insert(lines, p.Name)
                            end
                            
                            local infoParts = {}
                            if State.ESPShowHealth then
                                table.insert(infoParts, string.format("%d HP", math.floor(hum.Health)))
                            end
                            if State.ESPShowDistance then
                                table.insert(infoParts, string.format("%dm", math.floor(dist)))
                            end
                            
                            if #infoParts > 0 then
                                table.insert(lines, table.concat(infoParts, " • "))
                            end
                            
                            if State.ESPShowArmor then
                                local helmetName, helmetDura, armorName, armorDura = getArmorStats(char)
                                local armorLine = {}
                                if helmetName then table.insert(armorLine, "🪖 " .. helmetName:gsub(" Helmet", ""):gsub(" Helm", "")) end
                                if armorName then table.insert(armorLine, "👕 " .. armorName:gsub(" Armor", ""):gsub(" Vest", "")) end
                                if #armorLine > 0 then
                                    table.insert(lines, table.concat(armorLine, " "))
                                end
                            end
                            
                            guiData.Label.Text = table.concat(lines, "\n")
                            guiData.Label.TextColor3 = isVisible and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150)
                        end
                    end
                else
                    cleanEspForPlayer(p)
                end
            end
        end
    end)
    track(playerEspRenderConn)
end

