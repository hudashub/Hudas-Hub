-- ─── ZERO-LEAK SIGNAL & THREAD TRACKING ────────────────────────────
local _CONNS = setmetatable({}, {__mode = "k"})
local _THREADS = {}

local function track(conn)
    if conn then _CONNS[conn] = true end
    return conn
end

local function untrack(conn)
    if conn then
        pcall(function() conn:Disconnect() end)
        _CONNS[conn] = nil
    end
end

local function trackThread(t)
    table.insert(_THREADS, t)
    return t
end

-- Weak-key metatables prevent memory leaks when Instances despawn or unstream
local WalkerEspInstances = setmetatable({}, {__mode = "k"})
local LootEspInstances   = setmetatable({}, {__mode = "k"})
local originalHeadSizes  = setmetatable({}, {__mode = "k"})

local lootEspConnections = {}
local fovCircleGui

local function cleanEspForWalker(obj)
    if WalkerEspInstances[obj] then
        for _, inst in ipairs(WalkerEspInstances[obj]) do
            pcall(function() inst:Destroy() end)
        end
        WalkerEspInstances[obj] = nil
    end
end

local function cleanAllWalkerEsp()
    for obj, _ in pairs(WalkerEspInstances) do
        cleanEspForWalker(obj)
    end
end

local function cleanLootEsp(obj)
    if LootEspInstances[obj] then
        for _, inst in ipairs(LootEspInstances[obj]) do
            pcall(function() inst:Destroy() end)
        end
        LootEspInstances[obj] = nil
    end
end

local function cleanAllLootEsp()
    for obj, _ in pairs(LootEspInstances) do
        cleanLootEsp(obj)
    end
end

-- Centralized Player ESP Data
local PlayerEspGuis = setmetatable({}, {__mode = "k"})

local function cleanEspForPlayer(p)
    local guiData = PlayerEspGuis[p]
    if guiData then
        pcall(function() if guiData.Highlight then guiData.Highlight:Destroy() end end)
        pcall(function() if guiData.Billboard then guiData.Billboard:Destroy() end end)
        PlayerEspGuis[p] = nil
    end
end

local function cleanAllEsp()
    for p, _ in pairs(PlayerEspGuis) do
        cleanEspForPlayer(p)
    end
    -- Preserve the weak-key metatable — do NOT replace with a plain {}
    for k in pairs(PlayerEspGuis) do PlayerEspGuis[k] = nil end
end

local playerEspRenderConn = nil
local walkerThread = nil
local lootThread = nil
local hitboxThread = nil
local autoSurvivalThread = nil
local vehicleThread = nil
local animConn = nil

local function restoreHeadSizes()
    for head, origSize in pairs(originalHeadSizes) do
        if head and head.Parent then
            pcall(function()
                head.Size = origSize
                head.CanCollide = true
                head.Transparency = 0
            end)
        end
    end
    originalHeadSizes = setmetatable({}, {__mode = "k"})
end

_G.__TWDO_CLEANUP = function()
    if playerEspRenderConn then untrack(playerEspRenderConn); playerEspRenderConn = nil end
    if walkerThread then pcall(function() task.cancel(walkerThread) end); walkerThread = nil end
    if lootThread then pcall(function() task.cancel(lootThread) end); lootThread = nil end
    if hitboxThread then pcall(function() task.cancel(hitboxThread) end); hitboxThread = nil end
    if autoSurvivalThread then pcall(function() task.cancel(autoSurvivalThread) end); autoSurvivalThread = nil end
    if vehicleThread then pcall(function() task.cancel(vehicleThread) end); vehicleThread = nil end
    if animConn then untrack(animConn); animConn = nil end
    
    for conn, _ in pairs(_CONNS) do
        pcall(function() conn:Disconnect() end)
    end
    for _, t in ipairs(_THREADS) do
        pcall(function() task.cancel(t) end)
    end
    for _, c in ipairs(lootEspConnections) do pcall(function() c:Disconnect() end) end
    -- vehicleEspConnections declared later — guard with pcall
    pcall(function()
        for _, c in ipairs(vehicleEspConnections) do pcall(function() c:Disconnect() end) end
    end)
    -- Disconnect per-player health listeners
    pcall(function()
        for _, conn in pairs(playerHealthConns) do
            pcall(function() conn:Disconnect() end)
        end
        for k in pairs(playerHealthConns) do playerHealthConns[k] = nil end
    end)
    -- Cancel new threads that were added after original cleanup was written
    if playerEspUpdateThread then pcall(function() task.cancel(playerEspUpdateThread) end); playerEspUpdateThread = nil end
    if playerAddedConn then pcall(function() playerAddedConn:Disconnect() end); playerAddedConn = nil end
    if noclipPreSimConn then pcall(function() noclipPreSimConn:Disconnect() end); noclipPreSimConn = nil end
    lootEspConnections = {}
    vehicleEspConnections = {}

    cleanAllEsp()
    cleanAllWalkerEsp()
    cleanAllLootEsp()
    cleanAllVehicleEsp()
    restoreHeadSizes()
    
    pcall(_G.restoreGodMode)
    if fovCircleGui then
        pcall(function() fovCircleGui:Destroy() end)
    end
    _CONNS = setmetatable({}, {__mode = "k"})
    _THREADS = {}
end

