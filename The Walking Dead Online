local vehicleEspThread = nil
local vehicleEspConnections = {}

local function startVehicleEspLoop()
    for _, c in ipairs(vehicleEspConnections) do pcall(function() c:Disconnect() end) end
    vehicleEspConnections = {}

    if vehicleEspThread then
        pcall(function() task.cancel(vehicleEspThread) end)
        vehicleEspThread = nil
    end

    if not State.VehicleESP then
        cleanAllVehicleEsp()
        return
    end

    local function checkVehicleOrHorse(obj)
        if not obj or not obj:IsA("Model")
            or not obj:IsDescendantOf(workspace)
            or VehicleEspInstances[obj] then return end

        local isCar   = false
        local isHorse = false
        local name    = obj.Name

        if State.VehicleShowCars ~= false then
            if obj:FindFirstChildWhichIsA("VehicleSeat", true)
                or obj:FindFirstChild("DriveSeat",  true)
                or obj:FindFirstChild("DriverSeat", true) then
                isCar = true
            end
        end

        if State.VehicleShowHorses ~= false and not isCar then
            local lower = name:lower()
            if lower:match("horse") or lower:match("mount") or lower:match("steed")
                or lower:match("pinto") or lower:match("stallion") or lower:match("mare") then
                isHorse = true
            end
        end

        if isCar or isHorse then
            local tag = isHorse and ("🐎 " .. name) or ("🚗 " .. name)
            applyVehicleEsp(obj, isHorse, tag)
        end
    end

    -- Scan only the actual vehicle containers (not the entire workspace root)
    local scanTargets = {
        workspace:FindFirstChild("Cars"),           -- primary vehicle folder
        workspace:FindFirstChild("Vehicles"),
        workspace:FindFirstChild("CarSpawns"),
        workspace:FindFirstChild("AI") and workspace.AI:FindFirstChild("Wildlife"),
    }

    for _, container in ipairs(scanTargets) do
        if container then
            -- Scan existing children
            for _, child in ipairs(container:GetChildren()) do
                pcall(checkVehicleOrHorse, child)
            end
            -- Watch for new vehicles spawning
            local conn = container.ChildAdded:Connect(function(child)
                task.wait() -- let the object finish parenting before checking
                pcall(checkVehicleOrHorse, child)
            end)
            table.insert(vehicleEspConnections, conn)
            track(conn)
            -- Clean up ESP when vehicles are removed
            local remConn = container.ChildRemoved:Connect(function(child)
                pcall(cleanVehicleEsp, child)
            end)
            table.insert(vehicleEspConnections, remConn)
            track(remConn)
        end
    end

    vehicleEspThread = task.spawn(function()
        while State.VehicleESP and myLoopID == _G.TWDOLoopID do
            pcall(function()
                local char  = player.Character
                local myPos = char and char:FindFirstChild("HumanoidRootPart")
                    and char.HumanoidRootPart.Position
                    or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
                local maxDist = State.VehicleDistance or 1000

                local toProcess = {}
                for obj, insts in pairs(VehicleEspInstances) do
                    table.insert(toProcess, { obj = obj, insts = insts })
                end

                for idx, item in ipairs(toProcess) do
                    if idx % 20 == 0 then task.wait() end
                    if not State.VehicleESP then break end

                    local obj   = item.obj
                    local insts = item.insts

                    if not obj or not obj.Parent then
                        cleanVehicleEsp(obj)
                    else
                        local bb = insts[1]
                        local adornee = bb and bb.Adornee
                        if adornee and adornee:IsDescendantOf(workspace) and myPos then
                            local dist = math.floor((adornee.Position - myPos).Magnitude)
                            if dist <= maxDist then
                                local label = bb:FindFirstChildWhichIsA("TextLabel")
                                if label then
                                    local lowerName = obj.Name:lower()
                                    local isHorse = lowerName:match("horse") or lowerName:match("mount")
                                    local prefix  = isHorse and "🐎 " or "🚗 "
                                    label.Text = prefix .. obj.Name .. " • " .. dist .. "m"
                                end
                                bb.Enabled = true
                            else
                                bb.Enabled = false
                            end
                        elseif bb then
                            bb.Enabled = false
                        end
                    end
                end
            end)
            task.wait(0.5)
        end
    end)
    trackThread(vehicleEspThread)
end

