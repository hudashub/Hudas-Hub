-- ─── SILENT AIM — SHARED TARGET FINDER ────────────────────────────
-- Called at fire-time inside the __index hook so the position is always
-- the target's CURRENT location, not one that was cached 50ms ago.
local _walkerFolderA = workspace:FindFirstChild("AI") and workspace.AI:FindFirstChild("Walkers")
local _walkerFolderB = workspace:FindFirstChild("PresetWalkers")

local function findBestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local mousePos    = UserInputService:GetMouseLocation()
    local fov         = State.SilentAimFOV or 150
    local targetType  = State.SilentAimTargetType or "Both"
    local partPref    = State.SilentAimPart or "Head"
    local bestTarget  = nil
    local bestDist    = fov  -- pixel radius threshold

    local function evalChar(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        local partName = "Head"
        if partPref == "Body" then
            partName = char:FindFirstChild("UpperTorso") and "UpperTorso" or "Torso"
        elseif partPref == "Legs" then
            partName = char:FindFirstChild("LeftLowerLeg") and "LeftLowerLeg" or "LeftLeg"
        end

        local part = char:FindFirstChild(partName)
            or char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
        if not part then return end

        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then return end

        local pixelDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if pixelDist < bestDist then
            bestDist    = pixelDist
            bestTarget  = part
        end
    end

    if targetType == "Players" or targetType == "Both" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                pcall(evalChar, p.Character)
            end
        end
    end

    if targetType == "Walkers" or targetType == "Both" then
        -- Lazily refresh refs if not yet loaded at script start
        if not _walkerFolderA then
            _walkerFolderA = workspace:FindFirstChild("AI") and workspace.AI:FindFirstChild("Walkers")
        end
        if not _walkerFolderB then
            _walkerFolderB = workspace:FindFirstChild("PresetWalkers")
        end
        for _, folder in ipairs({_walkerFolderA, _walkerFolderB}) do
            if folder then
                for _, walker in ipairs(folder:GetChildren()) do
                    if walker:IsA("Model") then pcall(evalChar, walker) end
                end
            end
        end
    end

    return bestTarget
