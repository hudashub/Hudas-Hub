    local valLabel = mkLabel(holder, tostring(getState()), UDim2.new(0.55, -20, 1, 0), UDim2.new(0.4, 0, 0, 0), 12, Enum.Font.GothamBold, Color3.fromRGB(235, 70, 50), 1, Enum.TextXAlignment.Right)
    
    local idx = 1
    for i, it in ipairs(items) do if it == getState() then idx = i end end
    
    local btn = Instance.new("TextButton", holder)
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""
    btn.MouseButton1Click:Connect(function()
