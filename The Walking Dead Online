local function startWalkerEspLoop()
    if walkerThread then
        pcall(function() task.cancel(walkerThread) end)
        walkerThread = nil
    end
    
    if not State.WalkerESP then
        cleanAllWalkerEsp()
        return
    end
    
    -- Cache folder references once
    local walkerFolders = {
        workspace:FindFirstChild("AI") and workspace.AI:FindFirstChild("Walkers"),
        workspace:FindFirstChild("PresetWalkers")
    }

    -- Initial scan: apply ESP to all walkers already present
    for _, folder in ipairs(walkerFolders) do
        if folder then
            for _, walker in ipairs(folder:GetChildren()) do
                if walker:IsA("Model") then
                    local hum = walker:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and not WalkerEspInstances[walker] then
                        applyWalkerEsp(walker)
                    end
                end
            end
            -- Wire ChildAdded so new walkers get ESP immediately
            local conn = folder.ChildAdded:Connect(function(walker)
                if State.WalkerESP and walker:IsA("Model") then
                    task.wait() -- let properties settle
                    local hum = walker:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then applyWalkerEsp(walker) end
                end
            end)
            track(conn)
            local remConn = folder.ChildRemoved:Connect(function(walker)
                cleanEspForWalker(walker)
            end)
            track(remConn)
        end
    end

    walkerThread = task.spawn(function()
        -- Reuse a single table to avoid per-tick allocation
        local toProcess = {}
        while State.WalkerESP and myLoopID == _G.TWDOLoopID do
            pcall(function()
                local localChar = player.Character
                local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
                if not localHrp then return end

                local myPos   = localHrp.Position
                local maxDist = State.WalkerDistance or 300

                -- Build process list without allocating new table each tick
                local n = 0
                for obj, insts in pairs(WalkerEspInstances) do
                    n = n + 1; toProcess[n] = {obj = obj, insts = insts}
                end
                -- Clear stale entries beyond current count
                for i = n + 1, #toProcess do toProcess[i] = nil end

                for idx = 1, n do
                    if idx % 30 == 0 then task.wait() end
                    if not State.WalkerESP then break end

                    local item   = toProcess[idx]
                    local walker = item.obj
                    local insts  = item.insts

                    if not walker or not walker.Parent then
                        cleanEspForWalker(walker)
                    else
                        local hum = walker:FindFirstChild("Humanoid")
                        local bb  = insts[1]
                        if hum and hum.Health > 0 and bb and bb.Parent then
                            local hrp = walker:FindFirstChild("HumanoidRootPart") or walker.PrimaryPart
                            if hrp then
                                local dist    = (myPos - hrp.Position).Magnitude
                                local inRange = dist <= maxDist
                                bb.Enabled = inRange
                                if inRange then
                                    local label = bb:FindFirstChildWhichIsA("TextLabel")
                                    if label then
                                        label.Text = string.format("🧟 %s  •  %d HP  •  %dm",
                                            walker.Name, math.floor(hum.Health), math.floor(dist))
                                    end
                                end
                            end
                        else
                            cleanEspForWalker(walker)
                        end
                    end
                end
            end)
            task.wait(0.5)
        end
    end)
    trackThread(walkerThread)
end

