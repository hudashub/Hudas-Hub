local autoSurvivalThread = nil
local vehicleThread = nil
local animConn = nil

local function restoreHeadSizes()
    for head, origSize in pairs(originalHeadSizes) do
        if head and head.Parent then
            pcall(function()
                head.Size = origSize
                head.CanCollide = true
                head.Transparency = 0
            end)
        end
    end
    originalHeadSizes = setmetatable({}, {__mode = "k"})
end

_G.__TWDO_CLEANUP = function()
    if playerEspRenderConn then untrack(playerEspRenderConn); playerEspRenderConn = nil end
    if walkerThread then pcall(function() task.cancel(walkerThread) end); walkerThread = nil end
    if lootThread then pcall(function() task.cancel(lootThread) end); lootThread = nil end
    if hitboxThread then pcall(function() task.cancel(hitboxThread) end); hitboxThread = nil end
    if autoSurvivalThread then pcall(function() task.cancel(autoSurvivalThread) end); autoSurvivalThread = nil end
    if vehicleThread then pcall(function() task.cancel(vehicleThread) end); vehicleThread = nil end
    if animConn then untrack(animConn); animConn = nil end
    
    for conn, _ in pairs(_CONNS) do
        pcall(function() conn:Disconnect() end)
    end
    for _, t in ipairs(_THREADS) do
        pcall(function() task.cancel(t) end)
    end
    for _, c in ipairs(lootEspConnections) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(vehicleEspConnections) do pcall(function() c:Disconnect() end) end
    
    lootEspConnections = {}
    vehicleEspConnections = {}
    
    cleanAllEsp()
    cleanAllWalkerEsp()
    cleanAllLootEsp()
    cleanAllVehicleEsp()
    restoreHeadSizes()
    
    pcall(_G.restoreGodMode)
    if fovCircleGui then
        pcall(function() fovCircleGui:Destroy() end)
    end
    _CONNS = setmetatable({}, {__mode = "k"})
    _THREADS = {}
end

